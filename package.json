{
  "name": "joint-domain-data-compiler",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first trajectory and TSPI workbench for importing, analyzing, transforming, comparing, visualizing, saving, and exporting track data.",
  "desktopName": "JointDomainDataCompiler",
  "author": {
    "name": "A13Xg",
    "email": "a13xg@users.noreply.github.com"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"npm:dev\" \"npm:electron\"",
    "electron": "wait-on tcp:5173 && electron .",
    "build": "tsc -b && vite build",
    "build:web": "npm run build",
    "build:desktop": "npm run build && electron-builder --publish never",
    "build:desktop:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "build:desktop:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "test:legacy": "esbuild test/validate.ts --bundle --platform=node --format=esm --outfile=.test-build/validate.mjs && node .test-build/validate.mjs",
    "bench": "node --expose-gc scripts/run-benchmarks.mjs",
    "lint": "eslint .",
    "check:unit": "npm run lint && npm test",
    "check:web": "npm run build",
    "check:e2e": "npm run test:e2e",
    "check:desktop:linux": "node scripts/smoke-packaged.mjs",
    "check:desktop:win": "node scripts/smoke-packaged.mjs",
    "check:desktop:mac": "node scripts/smoke-packaged.mjs",
    "check:all": "npm run check:unit && npm run check:web",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.a13xg.jointdomaindatacompiler",
    "productName": "Joint Domain Data Compiler",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "afterPack": "scripts/electron-fuses.cjs",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "maintainer": "A13Xg <a13xg@users.noreply.github.com>"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "JointDomainDataCompiler"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-Windows-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-Windows-${arch}-Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "papaparse": "^5.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "linkedom": "^0.18.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
