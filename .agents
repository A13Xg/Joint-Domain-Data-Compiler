M{
  "project": {
    "name": "Joint Domain Data Compiler (JDDC)",
    "version": "0.2.0",
    "description": "TSPI (time-space-position-information) flight-data conversion & analysis workbench"
  },
  "idea": {
    "title": "JDDC: Single-User Engineering Workbench for TSPI Data",
    "vision": "A focused, single-screen instrument for importing, inspecting, transforming, comparing, visualizing, and exporting trajectory data (fighter-jet flight telemetry as primary domain, with equal support for ground tracks). Built as a dense, always-visible workbench where a solo engineer can work with precision and trust.",
    "core_principles": [
      "Single-screen, tabbed interface—not multi-window or router-based. All cross-cutting context (datasets, logs) stay visible.",
      "Data integrity first: all operations are observable, auditable, and reversible. Undo/redo as dataset snapshots; explicit operation history that can be replayed deterministically.",
      "Engineering-focused, not dashboard-ified: every UI decision serves precision and trust, not visual trends or passive consumption.",
      "Avionics-inspired interaction model: designated selection, linked cursors, quality-event overlays, explicit state modes (busy, selection, range, acquisition cursor).",
      "Graceful degradation: map tiles are the only network dependency; app degrades to offline grid on network failure.",
      "One UI system for both browser and Electron; desktop adds: persistent KML/KMZ library, project archive storage (`.jddc-project`), file system access via preload IPC, native packaged installer/export."
    ],
    "problem_scope": [
      "Data corruption risk: raw TSPI logs can have gaps, duplicates, coordinate jumps, elevation spikes, timestamp issues—these must be visible, not hidden.",
      "Workflow opacity: transforms (resample, smooth, etc.) should show before/after stats, operation history, revertibility.",
      "Chart validation: users can select invalid chart types for their data (e.g., time-series when no timestamps exist).",
      "Multi-source reconciliation: sensor fusion requires auditable registration and grouping logic, not opaque black-box combination."
    ]
  },
  "design_rules": {
    "ui_interaction": [
      "No modals except: project report export dialog and destructive-action confirmations (delete recipe, remove KML library entry).",
      "Selection state is shared: one pointIndex/indexRange/timeRange across Table/Chart/Map/3D. Selecting in any one view highlights all others.",
      "Disabled controls (disabled tabs, disabled buttons) render visually distinct but visible—communicate 'this is available when [condition]' rather than hiding.",
      "Tab bar never hides; sidebar (dataset list) never hides. Both are orthogonal concerns (data I have vs. what I'm doing with it).",
      "Acquisition cursor (hover): cyan (#38bdf8), transient, uncommitted. Selection cursor: orange (accent), persistent, can be cleared via chip × button.",
      "Quality events (gaps, duplicates, coordinate jumps, elevation faults) render consistently everywhere: dashed chart markers, colored map points, 3D break marks, table row flags.",
      "Two separate history mechanisms: interactive undo/redo (fast, snapshot-based, forgets nothing) and verified operation replay (deterministic, recipe-safe)."
    ],
    "code_organization": [
      "All tabs render inline in src/App.tsx's tab-content section—no router, no nested screens.",
      "Component files export only components (react-refresh/only-export-components rule enforced by eslint).",
      "Shared state modules in src/state/: pointSelection, workspaceDisplay, workspace, mapOverlays, history.",
      "Core data operations in src/core/: parsers, transformations, stats, quality detection, kinematic derivation.",
      "No new dependencies without justification; prefer native APIs (File/Blob/Web Crypto) over npm equivalents.",
      "React 19, Leaflet/react-leaflet for maps, no WebGL for 3D (hand-rolled 2D-canvas perspective renderer).",
      "All UI styles in src/index.css using CSS custom properties (design tokens); separate print-report CSS in src/analysis.css and inline in htmlReport.ts."
    ],
    "data_integrity": [
      "Every dataset transform produces: (1) a new in-memory dataset snapshot, (2) an operation record (for undo/redo and verified history), (3) a durable 'operation record' with operationId/version/params/scope/warnings.",
      "Undo/redo operates on snapshots; replay operates on the original as-loaded source + operation sequence (reproducibility).",
      "No lossy default transformations; every conditioning action requires explicit user confirmation and is always visible in the operation log.",
      "Dataset hashes (sha256) are stored for content verification; point-count and bbox ranges are computed and displayed for visibility.",
      "Quality events detected once per dataset by detectQualityEvents and shared across all views; not rediscovered per-panel."
    ],
    "performance": [
      "Deterministic benchmarks run on synthetic spiral-climb datasets at 100k/500k/1M points; results guide optimization.",
      "Map visual budget capped at ~4,000 points; datasets larger than that are downsampled for display (preservation of full data for export).",
      "DOM parsing (GPX/KML) deliberately capped at 100k points; larger datasets must use GPB (compact JDDC binary format) or parse in chunks via Worker.",
      "Chart rendering, 3D geometry construction, and project archive I/O all have performance baselines recorded; material regressions must be investigated before release.",
      "Long-running operations (CSV analysis, GPX export) route through cancellable Workers with progress-bar UI."
    ],
    "electron_desktop": [
      "Renderer runs with context isolation + sandboxing, no Node integration. Preload exposes only 5 KML/KMZ library IPC operations.",
      "Fuse V1 enforces: ASAR integrity (Windows/macOS; Linux disables due to electron-builder limitation), cookie encryption, no ELECTRON_RUN_AS_NODE/NODE_OPTIONS.",
      "Desktop adds: persistent overlay library storage, `.jddc-project` file save/open, KML/KMZ import from disk.",
      "Native packaged launch tests required for Windows/Linux/macOS release certification; app must start with Electron context isolation verified."
    ],
    "release_quality": [
      "Semantic versioning (X.Y.Z) without leading 'v' in package.json; matching vX.Y.Z git tags.",
      "Release checklist: npm run check:all, npm audit (runtime deps only), npm run bench, compare performance baseline, package on all platforms, verify SBOMs, provenance attestation.",
      "Never move an existing git tag; publish a new patch tag for corrections.",
      "If data loss or security issue: mark affected release as draft/prerelease, preserve evidence, provide recovery path in release notes.",
      "Rollback prefers corrective release (new version fixing the issue) over silent tag replacement."
    ]
  },
  "development_workflow": {
    "branch_strategy": {
      "canonical_main": "main (validated integration and release branch)",
      "active_development": "agent/roadmap-integration (single active development branch for roadmap work)",
      "working_policy": [
        "Start all roadmap work from agent/roadmap-integration.",
        "Commit incremental sub-goals to that branch.",
        "Keep one open pull request from agent/roadmap-integration to main.",
        "Run focused checks and full CI on each meaningful increment.",
        "Merge integration PR only at deliberate milestone.",
        "After merge, recreate or fast-forward agent/roadmap-integration from updated main before continuing.",
        "Historical agent/* branches may be deleted after confirming merge or closure."
      ]
    },
    "dependency_policy": {
      "node_minimum": "Node 22 (required by Vite 8, File/Blob/Web Crypto APIs in parsers)",
      "update_cadence": "Patch/minor: individual per-commit updates with full check:all gate after each. Major versions: dedicated branch with changelog review. Electron patches require native packaged-renderer smoke tests.",
      "lockfile": "package-lock.json committed, source of truth for CI. npm ci in workflows, never npm install. Any dependency modification must commit the resulting lockfile diff immediately.",
      "audit_thresholds": "Runtime deps: zero tolerance for high/critical vulnerabilities. Dev-only deps: tracked but do not block CI (build-time only). Never silent npm audit fix --force; resolve through tested upgrade or explicit pin.",
      "supply_chain_pins": "GitHub Actions by immutable commit SHA (tag in comment). Semgrep container by OCI manifest digest. Review and update deliberately, never use moving tags."
    },
    "release_checklist": [
      "Confirm intended version and user-visible scope.",
      "Update package.json, package-lock.json, README.md.",
      "Clean checkout of the exact commit to be tagged.",
      "npm ci (fresh dependency tree).",
      "Run: npm run check:all, npm audit --omit=dev --audit-level=high, npm run bench.",
      "Review benchmark deltas vs. performance-baseline; investigate material regressions.",
      "Run desktop package commands (Linux/Windows/macOS native smoke tests).",
      "Push release commit, wait for Quality Gates workflow.",
      "Create and push matching vX.Y.Z tag.",
      "Wait for all platform package jobs to complete.",
      "Verify: installers/archives per platform, SBOMs, SHA256SUMS.",
      "Test: sha256sum --check SHA256SUMS.txt, gh attestation verify.",
      "Review release notes for correctness, limitations, signing status, schema compatibility, security changes."
    ]
  },
  "architecture": {
    "tab_structure": "13 tabs in fixed order: Import, CSV Mapping, Overview, Map, Charts, Table, Compare, 3D, Transform, Project, Export, Sources, Fusion. Each tab maps to one component file in src/ui/; all tabs render conditionally inline in src/App.tsx (no router).",
    "shared_state_modules": [
      "pointSelection (usePointSelection): shared cursor across Table/Chart/Map/3D",
      "workspaceDisplay: per-dataset color/visibility (used by Sources, Map, sidebar)",
      "workspace: durable view settings (Map, Compare, 3D, Project; persisted in .jddc-project)",
      "mapOverlays: KML/KMZ overlay library state",
      "history: undo/redo snapshots",
      "detectQualityEvents: gap/duplicate/jump detection shared across all views"
    ],
    "ui_component_map": {
      "app_shell": "App.tsx (root layout, tab bar, sidebar, log console)",
      "always_mounted": [
        "LogConsole (subscribes to src/core/logger.ts)",
        "Spinner/ProgressBar (header busy indicator)",
        "ErrorBoundary (crash fallback)",
        "InfoTooltip (hover/focus bubbles)",
        "Toast (ephemeral notification)"
      ],
      "tab_panels": {
        "import": "ImportView.tsx",
        "mapping": "MappingPanel.tsx",
        "overview": "StatsPanel.tsx",
        "map": "MapView.tsx + MapOverlayPanel.tsx",
        "charts": "TimeSeriesChart.tsx (with ChartTypeSelector, ChartLegend, chart-type validator)",
        "table": "DataTable.tsx",
        "compare": "ComparisonPanel.tsx",
        "scene3d": "Trajectory3dPanel.tsx",
        "transform": "TransformPanel.tsx + NotionalSmoothingPanel.tsx + OperationHistoryPanel.tsx",
        "project": "ProjectPanel.tsx + ReportExportDialog.tsx",
        "export": "ExportPanel.tsx",
        "sources": "SourcesPanel.tsx",
        "fusion": "FusionPanel.tsx"
      }
    },
    "styling": {
      "main_stylesheet": "src/index.css (tokens, shell, all panel classes)",
      "analysis_stylesheet": "src/analysis.css (supplementary analysis-panel styles)",
      "report_stylesheet": "Inline in src/core/reports/htmlReport.ts (self-contained VectorPunk/HUD print report, independent design system from live app)"
    }
  },
  "key_constraints": [
    "Map tiles are only network dependency; app gracefully degrades to offline basemap.",
    "DOM parser capped at 100k points (memory limit); larger datasets route through GPB or chunked Worker export.",
    "Desktop mode adds: persistent KML/KMZ library, .jddc-project file storage, Electron IPC for file system access.",
    "No per-chart-type rendering fork yet (scatter/area types recognized but render as line chart; validator provides clear feedback about fit).",
    "ExportPanel GPX preview runs synchronously (separate hotspot from async worker export).",
    "Vision/synthetic-perspective 3D renderer is 2D canvas-based, not WebGL (hand-rolled, keeps dependencies lean).",
    "No mobile/tablet responsive design in current scope; Phase 2 planned."
  ],
  "git_ignore_status": ".agents is NOT ignored—it is version controlled and maintained alongside the codebase"
}
